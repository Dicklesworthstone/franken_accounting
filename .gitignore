# Build artifacts
/target
/target_local
target-*/
target_*/
crates/*/target/
a.out

# Loose compiled artifacts in the SOURCE tree. CARGO_TARGET_DIR always points
# outside the repo, so no legitimate build output ever belongs in-tree. A bare
# `rustc --crate-type=lib -` reading stdin emits `librust_out.rlib` into the
# CWD; this rule is the backstop so the class cannot reach a commit even when
# an ad-hoc harness invocation omits `-o`/`--out-dir`.
*.rlib
*.rmeta

# Book on-disk state — never commit. A live FrankenAccounting book is a
# FrankenGraphDB directory (manifest.root plus content-addressed, RaptorQ-coded
# symbol stores) and none of it belongs in git.
manifest.root
*.fgdb
*.fgdbdir/
/*.fgdbdir/
*.fabook/
/*.fabook/
/data/
/books/
/ecs-store/
*.symbols
*.capsule
*.anchor

# Key files: three nonempty lines of 64 hex characters, owner-only. Never.
*.keys
fa.keys
fgdb.keys

# Evidence bundles and proof exports (often large, always reproducible)
*.fab
/bundles/
/workpapers/

# Simulation / verification ephemera (fa-sim, oracles, crashpacks)
*.crashpack
/crashpacks/
/sim-traces/
*.trace
*.replay

# Benchmark artifacts (fa-bench)
/target/criterion/
*.flamegraph
flamegraph*.svg
perf.data
perf.data.old

# beads viewer local config and caches
.bv/

# Agent mail
.agent-mail-project-id
.agent-mail.yaml

# macOS (AppleDouble resource forks + Finder metadata)
.DS_Store
._*

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Golden-artifact test sidecars (written next to a golden on mismatch / pending
# bless; never committed — review the diff and re-bless via UPDATE_GOLDENS=1).
*.actual
*.snap.new

# Temporary files
*.tmp
*.bak
*.corrupt
*.corrupt-*

# Beads recovery/orphan artifacts
.beads/*.orphan_*
.beads/*.corrupt_*
.beads/*.pre_recovery_*
.beads/*.recover*.sql
.beads/*.bad_*
.beads/*.backup_*
.beads/*.rebuild_*
.beads/recovery*/
.beads_recovery/
.beads_recovery_*/
.beads/*.db-wal-cert
.beads/*.db-wal-cert-head
.beads/.*-wal-cert*
.beads/*.fsqlite-migration-state

# Remote compilation helper target trees (worker-local cargo target, gigabytes).
.rch-target/
.rch-target-*/

# Environment / local settings
.env
.claude/settings.local.json

# Ephemeral files (core dumps, profiling, agent config backups, etc.)
core.*
core
clippy.txt
clippy.json
clippy_results.json
check_output.txt
error.log
rustc-ice-*.txt

# NTM session state
.ntm/

# Root-level agent-generated scripts and scratch output
*.log
nohup.out
/*.txt
/*.py
/*.sh
/*.json
!package.json
/*.jsonl

# ACFS / agent-mail / MCP ephemeral patterns
codex.mcp.json
cursor.mcp.json
gemini.mcp.json
cline.mcp.json
opencode.json
.opencode.json.*.bak
windsurf.mcp.json
*.mcp.json.*.bak

# Agent session ephemeral files
SESSION_TODO.md
SESSION_REPORT.md
SESSION_*.md
ENHANCEMENT_PROPOSALS_FOR_THE_COMPREHENSIVE_PLAN.md
verify_*.sh
newfile.txt
repro_*.rs

# Python tooling cache (scripts/)
__pycache__/

# Skill-loop / repo-janitor scratch
.skill-loop-progress.md
.skill-loop-progress-*.md

# Durable test/crashpack artifact root pinned by .cargo/config.toml so
# asupersync lab-test crashpacks survive `cargo clean`; bundles stay untracked.
/artifacts/
